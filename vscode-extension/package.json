{
  "name": "mem-watchdog-status",
  "displayName": "Mem Watchdog",
  "description": "Prevents VS Code from being OOM-killed on ChromeOS Crostini — auto-installs a systemd memory watchdog daemon that kills Chrome/Playwright before the kernel kills VS Code.",
  "version": "0.3.14",
  "publisher": "CurtisFranks",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/chf3198/crostini-mem-watchdog.git"
  },
  "bugs": {
    "url": "https://github.com/chf3198/crostini-mem-watchdog/issues"
  },
  "homepage": "https://github.com/chf3198/crostini-mem-watchdog#readme",
  "author": {
    "name": "Curtis Franks",
    "email": "curtisfranks@gmail.com"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#16213e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "memory",
    "watchdog",
    "crostini",
    "chromebook",
    "oom",
    "linux",
    "chromeos",
    "system monitor",
    "resource monitor",
    "ram",
    "systemd",
    "oom-killer",
    "playwright",
    "debian"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node scripts/prepare.js",
    "vscode:uninstall": "node ./lifecycle.js",
    "build": "node scripts/prepare.js",
    "test": "node --test test/unit/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --exclude='test/**' --exclude='scripts/**' --exclude='node_modules/**' node --test test/unit/*.test.js",
    "test:stress": "node --expose-gc test/stress/update-stress.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "memWatchdog.showDashboard",
        "title": "Show Memory Dashboard",
        "category": "Mem Watchdog"
      },
      {
        "command": "memWatchdog.preflightCheck",
        "title": "Playwright Pre-flight Check",
        "category": "Mem Watchdog"
      },
      {
        "command": "memWatchdog.killChrome",
        "title": "Kill Chrome / Playwright Now",
        "category": "Mem Watchdog"
      },
      {
        "command": "memWatchdog.restartService",
        "title": "Restart Service",
        "category": "Mem Watchdog"
      }
    ],
    "configuration": {
      "title": "Mem Watchdog",
      "properties": {
        "memWatchdog.sigtermThresholdPct": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 50,
          "scope": "machine",
          "order": 1,
          "markdownDescription": "Send `SIGTERM` to Chrome/Playwright when `MemAvailable` drops below this % of total RAM. Default: `25` (~1.6 GB on a 6.3 GB system)."
        },
        "memWatchdog.sigkillThresholdPct": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 40,
          "scope": "machine",
          "order": 2,
          "markdownDescription": "Escalate to `SIGKILL` when `MemAvailable` drops below this %. Must be less than `#memWatchdog.sigtermThresholdPct#`. Default: `15` (~945 MB)."
        },
        "memWatchdog.psiThresholdPct": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 100,
          "scope": "machine",
          "order": 3,
          "markdownDescription": "Send `SIGTERM` on sustained memory stall: PSI `full avg10` exceeds this %. Default: `25`."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "mem-watchdog-status.memWatchdogAssistant",
        "name": "memwatchdog",
        "fullName": "Mem Watchdog Assistant",
        "description": "Inspect watchdog status and logs, and apply memory tuning profiles",
        "isSticky": false,
        "commands": [
          {
            "name": "status",
            "description": "Show memory and watchdog status snapshot"
          },
          {
            "name": "logs",
            "description": "Show recent mem-watchdog journal lines"
          },
          {
            "name": "tune",
            "description": "Apply a memory profile: balanced, conservative, or playwright"
          },
          {
            "name": "act",
            "description": "Run watchdog action: kill chrome, restart service, or open dashboard"
          }
        ],
        "disambiguation": [
          {
            "category": "watchdog-ops",
            "description": "Questions about mem-watchdog behavior, Linux memory pressure, watchdog logs, and tuning thresholds for constrained environments.",
            "examples": [
              "Show mem-watchdog status and RAM pressure",
              "Tail watchdog logs and explain recent kill actions",
              "Switch to a conservative memory profile",
              "Kill Chrome now to protect VS Code"
            ]
          }
        ]
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/mem-watchdog-ops/SKILL.md"
      }
    ]
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
